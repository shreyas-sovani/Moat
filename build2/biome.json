{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"include": [
			"package.json",
			"turbo.json",
			"biome.json",
			"tsconfig.base.json",
			"vitest.config.ts",
			"apps/web/**/*.ts",
			"apps/web/**/*.tsx",
			"apps/web/**/*.css",
			"apps/worker/**/*.ts",
			"packages/**/*.ts"
		],
		"ignore": [
			"node_modules",
			"**/node_modules",
			"dist",
			"**/dist",
			".next",
			"**/.next",
			".next-web",
			".turbo",
			"**/.turbo",
			"coverage",
			"config/action-schemas.json",
			"packages/db/prisma/migrations",
			"docs/journal",
			"**/*.d.ts",
			"**/*.js",
			"**/*.map",
			"*.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"organizeImports": {
		"enabled": true
	}
}
